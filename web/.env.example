# The ANON key, never the service key.
# Anon is meant to be public: the tables are read-only to it because of
# the row-level security policies in sql/schema.sql. The service key
# bypasses RLS and must stay in GitHub Secrets, used only by the pipeline.
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
